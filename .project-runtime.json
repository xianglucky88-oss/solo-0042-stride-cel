{
  "language": "JavaScript (Node.js + Browser ES modules)",
  "project_shape": "fullstack",
  "source_extensions": [
    ".mjs",
    ".html",
    ".css"
  ],
  "build_command": "node tools/check.mjs",
  "testing": "deferred",
  "workflow_checks": [
    {
      "workflow_id": "proof",
      "command": "node tools/workflow.mjs proof"
    },
    {
      "workflow_id": "mirror",
      "command": "node tools/workflow.mjs mirror"
    },
    {
      "workflow_id": "windows",
      "command": "node tools/workflow.mjs windows"
    },
    {
      "workflow_id": "events",
      "command": "node tools/workflow.mjs events"
    },
    {
      "workflow_id": "seam",
      "command": "node tools/workflow.mjs seam"
    },
    {
      "workflow_id": "import",
      "command": "node tools/workflow.mjs import"
    },
    {
      "workflow_id": "freeze",
      "command": "node tools/workflow.mjs freeze"
    },
    {
      "workflow_id": "suite",
      "command": "node tools/workflow.mjs suite"
    },
    {
      "workflow_id": "suite-missing",
      "command": "node tools/workflow.mjs suite-missing"
    },
    {
      "workflow_id": "suite-reopen",
      "command": "node tools/workflow.mjs suite-reopen"
    },
    {
      "workflow_id": "suite-integrity",
      "command": "node tools/workflow.mjs suite-integrity"
    },
    {
      "workflow_id": "download",
      "command": "node tools/workflow.mjs download"
    },
    {
      "workflow_id": "reopen",
      "command": "node tools/workflow.mjs reopen"
    },
    {
      "workflow_id": "integrity",
      "command": "node tools/workflow.mjs integrity"
    }
  ]
}
